{
  "manifest_version": 3,
  "name": "PageAgent - Your AI Agent in browser",
  "description": "PageAgent brings AI agents into your browser, helping you automate tasks smartly.",
  "version": "0.1.5",
  "default_locale": "en",
  "action": { "default_title": "Open PageAgent" },
  "side_panel": { "default_path": "sidepanel.html" },
  "sidebar_action": { "default_panel": "sidepanel.html", "default_title": "Open PageAgent" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js", "type": "module" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Ctrl+J", "mac": "Command+J" } }
  },
  "permissions": ["scripting", "tabs", "storage", "tabGroups", "search", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "web_accessible_resources": [{ "resources": ["element-selector.js"], "matches": ["<all_urls>"] }]
}
